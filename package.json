{
  "name": "lost-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "styles",
    "THIRD_PARTY_NOTICES.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./effects": {
      "types": "./dist/effects/index.d.ts",
      "import": "./dist/effects/index.js"
    },
    "./effects/*": {
      "types": "./dist/effects/*.d.ts",
      "import": "./dist/effects/*.js"
    },
    "./ui/*": {
      "types": "./dist/ui/*.d.ts",
      "import": "./dist/ui/*.js"
    },
    "./lib/cn": {
      "types": "./dist/lib/cn.d.ts",
      "import": "./dist/lib/cn.js"
    },
    "./styles.css": "./styles/styles.css",
    "./effects.css": "./styles/effects.css",
    "./theme-neutral.css": "./styles/theme-neutral.css"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "barrels": "node scripts/generate-barrels.mjs"
  },
  "peerDependencies": {
    "motion": "^13.0.0 || ^14.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.1.0",
    "cobe": "^0.6.5",
    "canvas-confetti": "^1.9.4",
    "svg-dotted-map": "^2.0.1",
    "rough-notation": "^0.5.1",
    "react-tweet": "^3.3.1",
    "shiki": "^4.5.0",
    "@shikijs/transformers": "^4.5.0",
    "tw-animate-css": "^1.3.0"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    },
    "cobe": {
      "optional": true
    },
    "canvas-confetti": {
      "optional": true
    },
    "svg-dotted-map": {
      "optional": true
    },
    "rough-notation": {
      "optional": true
    },
    "react-tweet": {
      "optional": true
    },
    "shiki": {
      "optional": true
    },
    "@shikijs/transformers": {
      "optional": true
    }
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.575.0",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@shikijs/transformers": "^4.5.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "canvas-confetti": "^1.9.4",
    "cobe": "^0.6.5",
    "motion": "^14.7.1",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-tweet": "^3.3.1",
    "rough-notation": "^0.5.1",
    "shiki": "^4.5.0",
    "svg-dotted-map": "^2.0.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  }
}
